{
  "name": "KhanatoonMuna",
  "private": true,
  "version": "1.0.0",
  "description": "Cartoon 3D story short rendered with three.js inside Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts BridgeShortCaptioned out/video.mp4 --codec=h264 --crf=16 --gl=angle --concurrency=1 --timeout=300000",
    "render:clean": "remotion render src/index.ts BridgeShort out/clean.mp4 --codec=h264 --crf=16 --gl=angle --concurrency=1 --timeout=300000",
    "render:parts": "node scripts/render-parts.mjs",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/bundler": "4.0.544",
    "@remotion/cli": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "@remotion/three": "4.0.544",
    "postprocessing": "6.37.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.544",
    "three": "0.175.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.0",
    "@types/three": "0.175.0",
    "typescript": "5.8.3"
  }
}
